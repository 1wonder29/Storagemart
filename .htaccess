# C:\xampp\htdocs\tms - only public/ is meant to be reached by browsers.
Options -Indexes
RewriteEngine On
RewriteBase /tms/

# Block app code, config, .env and logs.
RewriteRule ^(app|config|scripts)(/|$) - [F,L]
RewriteRule (^|/)\.env - [F,L]

# http://localhost/tms -> http://localhost/tms/public/login
RewriteRule ^$ public/login [R=302,L]

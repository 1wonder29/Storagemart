# Environment Configuration
# Copy this file to .env and update values for your environment

# Application Environment (development enables auto page reload on file saves)
APP_ENV=development

# Optional: BrowserSync port if you run `npm run dev` (requires Node.js)
BROWSER_SYNC_PORT=3000

# Base URL for the application
BASE_URL=

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=howard_tms
DB_USER=root
DB_PASS=

# For production, use strong credentials:
# DB_USER=storagemart_user
# DB_PASS=your_strong_password_here
